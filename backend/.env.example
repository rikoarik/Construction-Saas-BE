# Copy to .env.local for local development. Never commit real secrets.
# Generate keys with: openssl rand -hex 32
DATABASE_URL=postgres://construction_saas:construction_saas@127.0.0.1:5432/construction_saas_auth_dev?sslmode=disable
APP_ENV=development
API_ADDR=:8090
# Set to the frontend origin used by recipients; local 3000 needs BACKEND_ORIGIN.
APP_PUBLIC_URL=http://localhost:3000

# Required in production. At least 32 bytes.
CSRF_SECRET=
TRUSTED_ORIGINS=http://localhost:3000

# 32-byte encryption keys (hex or base64). MFA protects TOTP secrets;
# EMAIL protects one-time link secrets stored for the outbox worker.
MFA_ENCRYPTION_KEY=
EMAIL_ENCRYPTION_KEY=
METADATA_HMAC_KEY=

# SMTP relay. TLS is mandatory: implicit for port 465, starttls otherwise.
SMTP_ADDR=smtp.example.com:465
SMTP_HOST=smtp.example.com
SMTP_TLS_MODE=implicit
SMTP_USERNAME=
SMTP_PASSWORD=
# For Sumopod: use an address at a verified Custom Domain, not a .local address.
# Verify the domain and check Email SMTP > Activity Log in the Sumopod dashboard.
SMTP_FROM=no-reply@example.com

# Optional in-process HTTP limiters.
LOGIN_RATE_LIMIT_CAPACITY=10
LOGIN_RATE_LIMIT_WINDOW=1m
API_RATE_LIMIT_CAPACITY=120
API_RATE_LIMIT_WINDOW=1m
